{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "allowSyntheticDefaultImports": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "paths": {
      "@config/log": ["./src/config/log.js"],
      "@config/env": ["./src/config/env.js"],
      "@config/shutdown": ["./src/config/shutdown.js"],
      "@middleware/log": ["./src/middleware/logger.js"],
      "@middleware/err":["./src/middleware/errorHandler.js"]
    }
  },
  "include": ["src/**/*", "vitest.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts"
  ] /* Files to ignore */
}
